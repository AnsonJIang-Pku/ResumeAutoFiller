{
  "name": "resumeautofiller",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only, privacy-first Chromium extension for deterministic resume form filling.",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "privacy:audit": "node scripts/privacy-audit.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm privacy:audit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.0.270",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8"
  }
}
